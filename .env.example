# qsurvey — environment variables

# Runtime token used by the SDK and CLI. Scope: whatever your user has in Qualtrics.
# Per docs/authentication.md, this is read from the user's Account Settings →
# Qualtrics IDs → API panel. See docs/permissions-and-scopes.md for the exact
# permissions different endpoints require.
QUALTRICS_API_TOKEN=

# Data center ID: iad1, fra1, syd1, pdx1, etc. Discover via Account Settings →
# Qualtrics IDs → User → Datacenter ID. See docs/authentication.md.
QUALTRICS_DATA_CENTER=

# --- Dev-only MCP configuration (see docs/mcp-dev-setup.md) ---

# A token scoped for the MCP server's dev/sandbox use. Prefer a separate token
# from QUALTRICS_API_TOKEN so you can revoke the MCP's access without breaking
# the rest of your dev workflow. Point it at a non-production survey brand
# where possible.
QUALTRICS_DEV_TOKEN=
